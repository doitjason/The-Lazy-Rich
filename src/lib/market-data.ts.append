
// ═══════════════════════════════════════════════════════
// 배당 캘린더 데이터 (Dividend Calendar)
// ═══════════════════════════════════════════════════════

export async function fetchDividendCalendar(tickers: string[]): Promise<DividendCalendarData> {
    const events: DividendCalendarData = [];
    const uniqueTickers = Array.from(new Set(tickers)).filter(t => t);

    // Get dates for 1 year range
    const now = new Date();
    const oneYearAgo = new Date();
    oneYearAgo.setFullYear(now.getFullYear() - 1);
    
    // Using string dates for cache keys
    const cacheKey = `dividends:${uniqueTickers.sort().join(",")}:${now.toISOString().split('T')[0]}`;
    const cached = marketCache.get<DividendCalendarData>(cacheKey);
    // Longer cache for dividends (24h)
    if (cached) return cached;

    await Promise.all(
        uniqueTickers.map(async (ticker) => {
            try {
                const queryTicker = resolveKoreanTicker(ticker);
                
                // 1. Past Dividends (Historical)
                const history = await yahooFinance.historical(queryTicker, {
                    period1: oneYearAgo,
                    period2: now, // Up to now
                    interval: "1d",
                    events: 'dividends'
                });

                // Filter for dividend events
                const dividends = history.filter((e: any) => e.events === "dividends" || e.dividends);

                dividends.forEach((e: any) => {
                    events.push({
                        ticker: ticker, // Use original ticker for display
                        date: new Date(e.date).toISOString().split('T')[0], // YYYY-MM-DD
                        amount: e.dividends,
                        exDate: new Date(e.date).toISOString().split('T')[0]
                    });
                });

                // 2. Future/Next Dividend (Calendar Events)
                try {
                    const summary = await fetchSummary(queryTicker, ["calendarEvents"]);
                    if (summary && summary.calendarEvents) {
                        const cal = summary.calendarEvents as any;
                        if (cal.exDividendDate) {
                             const exDate = new Date(cal.exDividendDate);
                             const payDate = cal.dividendDate ? new Date(cal.dividendDate) : undefined;
                             
                             // Check if this future event is already in history (by date match)
                             const exists = events.some(e => e.ticker === ticker && e.date === exDate.toISOString().split('T')[0]);
                             
                             if (!exists) {
                                 // Amount might not be in calendarEvents, need to estimate or fetch
                                 // calendarEvents often doesn't have amount. We use last dividend amount as estimate.
                                 const lastAmount = events.filter(e => e.ticker === ticker).sort((a,b) => b.date.localeCompare(a.date))[0]?.amount ?? 0;
                                 
                                 events.push({
                                     ticker: ticker,
                                     date: exDate.toISOString().split('T')[0],
                                     amount: lastAmount, // Estimated
                                     exDate: exDate.toISOString().split('T')[0],
                                     paymentDate: payDate ? payDate.toISOString().split('T')[0] : undefined
                                 });
                             }
                        }
                    }
                } catch (e) {
                    // precise calendar fetch failed
                }

            } catch (error) {
                console.warn(`Failed to fetch dividends for ${ticker}`, error);
            }
        })
    );
    
    // Sort by date descending
    events.sort((a, b) => b.date.localeCompare(a.date));

    marketCache.set(cacheKey, events, 24 * 60 * 60); // 24 hours cache
    return events;
}
